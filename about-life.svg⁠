<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 220" width="100%" height="100%">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&amp;family=Inter:wght@400;600;700&amp;display=swap');
    .bg { fill: #0d0e16; }
    .border { stroke: #a78bfa; stroke-width: 1.5; fill: none; opacity: 0.4; }
    .text-title { font-family: 'Inter', sans-serif; font-weight: 700; fill: #a78bfa; font-size: 18px; }
    .text-body { font-family: 'Fira Code', monospace; fill: #e2e8f0; font-size: 13px; }
    .skill-badge { fill: #1e1b4b; stroke: #f472b6; stroke-width: 1; }
    .carousel { transform-origin: center; animation: slideShow 12s infinite; }
    
    @keyframes slideShow {
      0%, 25% { transform: translateY(0px); opacity: 1; }
      28%, 50% { transform: translateY(-40px); opacity: 1; }
      53%, 75% { transform: translateY(-80px); opacity: 1; }
      78%, 100% { transform: translateY(-120px); opacity: 1; }
    }
    
    .loading-bar { fill: none; stroke: #f472b6; stroke-width: 3; stroke-dasharray: 200; stroke-dashoffset: 200; animation: fillBar 4s linear infinite; }
    @keyframes fillBar { 0% { stroke-dashoffset: 200; } 100% { stroke-dashoffset: 0; } }
  </style>

  <rect width="800" height="220" class="bg" rx="16"/>
  <rect width="796" height="216" x="2" y="2" class="border" rx="14"/>

  <!-- Left: Abilities & Roles -->
  <g transform="translate(30, 35)">
    <text x="0" y="20" class="text-title">💡 WHAT I BUILD</text>
    <text x="0" y="55" class="text-body">• Custom &amp; interactive web platforms.</text>
    <text x="0" y="80" class="text-body">• Dynamic user interfaces with React.</text>
    <text x="0" y="105" class="text-body">• Scalable backend solutions &amp; UI designs.</text>
    <text x="0" y="130" class="text-body">• SEO &amp; online presence optimization.</text>
  </g>

  <!-- Vertical Divider -->
  <line x1="420" y1="25" x2="420" y2="195" stroke="#a78bfa" stroke-opacity="0.3" stroke-width="1"/>

  <!-- Right: Hobbies & Personal (Carousel) -->
  <g transform="translate(460, 35)">
    <text x="0" y="20" class="text-title" style="fill:#f472b6;">🎯 HOBBIES &amp; PASSION</text>
    <line x1="0" y1="35" x2="200" y2="35" stroke="#e2e8f0" stroke-opacity="0.2" stroke-width="3"/>
    <line x1="0" y1="35" x2="200" y2="35" class="loading-bar"/>

    <!-- Sliding viewport to capture hobbies -->
    <g transform="translate(0, 50)" clip-path="url(#carousel-clip)">
      <g class="carousel">
        <!-- Slide 1 -->
        <g transform="translate(0, 10)">
          <text x="0" y="15" class="text-body" style="fill:#22d3ee; font-weight: bold;">🎮 GAMING</text>
          <text x="0" y="35" class="text-body" style="font-size:12px; fill:#94a3b8;">Leveling up on visual and interactive challenges.</text>
        </g>
        <!-- Slide 2 -->
        <g transform="translate(0, 50)">
          <text x="0" y="15" class="text-body" style="fill:#22d3ee; font-weight: bold;">📸 PHOTOGRAPHY</text>
          <text x="0" y="35" class="text-body" style="font-size:12px; fill:#94a3b8;">Capturing life framing and cinematic narratives.</text>
        </g>
        <!-- Slide 3 -->
        <g transform="translate(0, 90)">
          <text x="0" y="15" class="text-body" style="fill:#22d3ee; font-weight: bold;">✈️ TRAVELING</text>
          <text x="0" y="35" class="text-body" style="font-size:12px; fill:#94a3b8;">Exploring cultures and drawing creative inspiration.</text>
        </g>
        <!-- Slide 4 -->
        <g transform="translate(0, 130)">
          <text x="0" y="15" class="text-body" style="fill:#22d3ee; font-weight: bold;">💼 BUSINESS</text>
          <text x="0" y="35" class="text-body" style="font-size:12px; fill:#94a3b8;">Venturing into tech and digital creative industries.</text>
        </g>
      </g>
    </g>
  </g>
  
  <defs>
    <clipPath id="carousel-clip">
      <rect width="320" height="110"/>
    </clipPath>
  </defs>
</svg>
